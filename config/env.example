# Environment variables required by ai-investment-pipeline
# Copy this file to .env and fill in your actual keys.
# Never commit .env to version control.
#
# Usage:
#   cp config/env.example .env
#   # edit .env with real values
#   source .env          # or use direnv / python-dotenv

# Alpha Vantage — price/fundamental data
# Get a free key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Google API — used by LLMAnalyst (Gemini)
# Get a key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# NewsAPI — market news for LLM context
# Get a free key at: https://newsapi.org/register
NEWS_API_KEY=your_news_api_key_here
