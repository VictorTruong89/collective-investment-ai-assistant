-        falsifiers=falsifiers, verdict=parsed.verdict,
-        conviction=parsed.conviction, bear_case=bear,
-        scorecard={}, confidence=UNMEASURED_CONFIDENCE,
-        bull_run_ids=(verdict_call.run.call_id,), run_id=run_id,
-        thesis_version=1)
