-        evidence_order=tuple(
-            list(p.kind for p in bundle.parts)[rotation:]
-             + list(p.kind for p in bundle.parts)[:rotation]),
-        option_permutation=verdict_call.run.option_permutation,
-        run_ids=tuple(c.run.call_id for c in calls),
